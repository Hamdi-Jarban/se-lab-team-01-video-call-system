<Window x:Class="VideoCall.Client.Views.CallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="المكالمة" Height="640" Width="520" WindowStartupLocation="CenterScreen">
    <Grid Background="#060A12"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Border Background="#0C1422" CornerRadius="0"><Image Source="{Binding RemoteVideo}" Stretch="Uniform" /></Border><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding RemoteVideo, Converter={StaticResource NullToVisibilityConverter}}"><Border Background="#182A47" CornerRadius="50" Width="78" Height="78" HorizontalAlignment="Center"><TextBlock Text="VC" Foreground="{StaticResource BrushPrimary}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding OtherParty}" Foreground="{StaticResource BrushTextPrimary}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" /><TextBlock Text="{Binding StateText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,7,0,0" /></StackPanel><Border Background="#AA101A2B" CornerRadius="18" Padding="13,7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"><TextBlock Text="{Binding StateText}" Foreground="White" FontSize="13" /></Border><Border Width="150" Height="108" CornerRadius="14" Background="{StaticResource BrushSurface}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" ClipToBounds="True"><Image Source="{Binding LocalVideo}" Stretch="UniformToFill" /></Border></Grid>
        <Border Grid.Row="1" Background="#0C1422" Padding="18,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Width="68" Height="58" Margin="7,0" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleMuteCommand}"><TextBlock Text="{Binding IsMuted, Converter={StaticResource MuteLabelConverter}}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" /></Button><Button Width="68" Height="58" Margin="7,0" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleCameraCommand}"><TextBlock Text="{Binding IsCameraOn, Converter={StaticResource CameraLabelConverter}}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" /></Button><Button Width="78" Height="58" Margin="7,0" Style="{StaticResource DangerButton}" Command="{Binding EndCallCommand}"><TextBlock Text="إنهاء" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" /></Button></StackPanel></Border>
    </Grid>
</Window>
