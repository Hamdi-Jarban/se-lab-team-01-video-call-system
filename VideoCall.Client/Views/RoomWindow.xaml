<Window x:Class="VideoCall.Client.Views.RoomWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الغرف الجماعية" Height="700" Width="960" MinHeight="580" MinWidth="760" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryDark}" Padding="28,18"><Grid><StackPanel><TextBlock Text="الغرف الجماعية" Foreground="White" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="اجتمعوا في مكان واحد" Foreground="#BFE8DF" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Style="{StaticResource StatusPill}" Background="#E3FFF1" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StatusMessage}" Foreground="#087F5B" /></Border></Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,22,24,16" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="معرف الغرفة" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource RoundedTextBox}" Height="48" Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasRoom, Converter={StaticResource InverseBooleanConverter}}" /></StackPanel><Button Grid.Column="1" Content="إنشاء غرفة" Style="{StaticResource PrimaryButton}" Margin="12,19,4,0" Command="{Binding CreateRoomCommand}" IsEnabled="{Binding HasRoom, Converter={StaticResource InverseBooleanConverter}}" /><Button Grid.Column="2" Content="انضمام" Style="{StaticResource SecondaryButton}" Margin="4,19,0,0" Command="{Binding JoinRoomCommand}" IsEnabled="{Binding HasRoom, Converter={StaticResource InverseBooleanConverter}}" /></Grid></Border>
        <Grid Grid.Row="2" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#DFF7F1" CornerRadius="16" Padding="30" Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center"><Border Background="#BDF0E3" CornerRadius="14" Padding="12" HorizontalAlignment="Right"><TextBlock Text="● غرفة نشطة" Foreground="{StaticResource BrushPrimaryDark}" FontWeight="SemiBold" /></Border><TextBlock Text="{Binding RoomId, StringFormat='الغرفة الحالية: {0}'}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,20,0,0" /><TextBlock Text="{Binding Host, StringFormat='المضيف: {0}'}" Foreground="{StaticResource BrushPrimaryDark}" Margin="0,8,0,20" /><TextBlock Text="{Binding IsMediaActive, StringFormat='حالة الاتصال: {0}'}" Foreground="{StaticResource BrushTextSecondary}" /><TextBlock Text="عندما تصبح جاهزًا، ابدأ الاتصال الجماعي من الزر الأخضر بالأسفل." Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="18" Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="الأعضاء" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding Members.Count, StringFormat=' ({0})'}" Foreground="{StaticResource BrushTextMuted}" /></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Members}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,3"><DockPanel><Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" /><TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" /></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="ابحث واختر عميلًا متصلًا" Style="{StaticResource FieldLabel}" /><ComboBox Style="{StaticResource RoundedComboBox}" Height="40" ItemsSource="{Binding OnlineUsers}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Text="{Binding NewMemberUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="اكتب بداية الاسم ثم اختره من القائمة" /><Button Content="إضافة العضو المختار" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Command="{Binding AddUserCommand}" IsEnabled="{Binding IsMediaActive, Converter={StaticResource InverseBooleanConverter}}" /></StackPanel></Grid></Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="24,18,24,24"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="بدء الصوت والفيديو" Style="{StaticResource SuccessButton}" Command="{Binding StartMediaCommand}" IsEnabled="{Binding IsHost}" /><Button Content="إيقاف الاتصال" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding StopMediaCommand}" IsEnabled="{Binding IsMediaActive}" /><Button Content="مغادرة الغرفة" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding LeaveRoomCommand}" /></StackPanel></DockPanel>
    </Grid>
</Window>
