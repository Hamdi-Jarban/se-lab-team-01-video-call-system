<Window x:Class="VideoCall.Client.Views.RegisterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إنشاء حساب — VideoCallSystem" Height="690" Width="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Border Style="{StaticResource CardStyle}" Margin="24" Padding="34"><StackPanel VerticalAlignment="Center">
        <TextBlock Text="إنشاء حساب جديد" Style="{StaticResource TitleText}" /><TextBlock Text="أنشئ ملفك وابدأ التواصل مع فريقك" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,7,0,25" />
        <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource RoundedTextBox}" Height="48" Margin="0,0,0,13" TextAlignment="Left" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="الاسم المعروض (اختياري)" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource RoundedTextBox}" Height="48" Margin="0,0,0,13" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" Height="48" Margin="0,0,0,13" />
        <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="ConfirmBox" Style="{StaticResource RoundedPasswordBox}" Height="48" Margin="0,0,0,13" />
        <TextBlock Text="عنوان الخادم" Style="{StaticResource FieldLabel}" /><TextBox Style="{StaticResource RoundedTextBox}" Height="48" Margin="0,0,0,23" TextAlignment="Left" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="إنشاء الحساب" Style="{StaticResource PrimaryButton}" Height="48" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Click="Register_Click" />
        <TextBlock Text="{Binding Status}" Foreground="#FF9DA7" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
    </StackPanel></Border>
</Window>
