<Window x:Class="VideoCall.Client.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المحادثات — VideoCallSystem" Width="1180" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryDark}" Padding="24,14">
            <Grid><StackPanel><TextBlock Text="المحادثات" Foreground="White" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="رسائلك ومجموعاتك في مكان واحد" Foreground="#BFE8DF" FontSize="12" Margin="0,3,0,0" /></StackPanel><TextBlock Text="● متصل الآن" Foreground="#9BF0C5" HorizontalAlignment="Left" VerticalAlignment="Center" /></Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16" Margin="0,0,9,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="قائمة الدردشات" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,16" />
                        <TextBlock Text="محادثة خاصة جديدة" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Style="{StaticResource RoundedComboBox}" Height="40" ItemsSource="{Binding OnlineUsers}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Text="{Binding NewChatUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="اكتب بداية الاسم ثم اختر العميل"><ComboBox.InputBindings><KeyBinding Key="Return" Command="{Binding OpenPrivateChatCommand}" /></ComboBox.InputBindings></ComboBox><Button Grid.Column="1" Content="فتح" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="7,0,0,0" Command="{Binding OpenPrivateChatCommand}" /></Grid>
                        <TextBlock Text="إنشاء مجموعة" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Margin="0,0,0,6" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Style="{StaticResource RoundedComboBox}" Height="40" Margin="0,0,0,7" ItemsSource="{Binding OnlineUsers}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" ToolTip="اكتب بداية اسم العميل ثم اختره. يمكن إدخال أكثر من اسم مفصولًا بفاصلة" Text="{Binding NewGroupMembers, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="إنشاء المجموعة" Style="{StaticResource SuccessButton}" Margin="0,0,0,17" Command="{Binding CreateGroupCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ConversationsView}" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" Margin="4,10,4,4" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" /><TextBlock Text="{Binding Preview}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource BrushPrimary}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center" Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="12" /></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="0" Margin="0,0,9,0">
                <Grid>
                    <TextBlock Text="اختر محادثة من القائمة للبدء" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedConversation, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Grid Visibility="{Binding IsConversationSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,12"><DockPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" /><TextBlock Text="متاح للمراسلة" Foreground="{StaticResource BrushSuccess}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button Content="اتصال" Style="{StaticResource SuccessButton}" Padding="15,8" DockPanel.Dock="Left" Command="{Binding CallCommand}" Visibility="{Binding IsPrivateSelected, Converter={StaticResource BooleanToVisibilityConverter}}" /></DockPanel></Border>
                        <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Background="#EFEAE2"><StackPanel Margin="16,16"><Button Content="تحميل رسائل أقدم" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,0,0,10" Command="{Binding LoadOlderCommand}" Visibility="{Binding HasMoreHistory, Converter={StaticResource BooleanToVisibilityConverter}}" /><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border x:Name="Bubble" Background="White" CornerRadius="11" Padding="12,8" Margin="4" MaxWidth="500" HorizontalAlignment="Left" ContextMenuOpening="Bubble_ContextMenuOpening"><Border.ContextMenu><ContextMenu><MenuItem Header="تعديل" Click="EditMessage_Click" /><MenuItem Header="حذف" Click="DeleteMessage_Click" /></ContextMenu></Border.ContextMenu><StackPanel><TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" /><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" /><TextBlock Text=" · معدّلة" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Visibility="{Binding IsEdited, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter TargetName="Bubble" Property="Background" Value="#D9FDD3" /><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
                        <Grid Grid.Row="2" Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Padding="10,3" Command="{Binding CancelEditCommand}" /><TextBlock Text="جارٍ تعديل رسالتك…" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" /></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource RoundedTextBox}" Height="48" MaxLength="4000" Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SendCommand}" /></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="إرسال" Style="{StaticResource PrimaryButton}" Height="48" Margin="8,0,0,0" Padding="21,0" Command="{Binding SendCommand}" /></Grid></Grid><TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" Margin="14,0,14,10" /></Grid>
                    </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16" Visibility="{Binding IsGroupSelected, Converter={StaticResource BooleanToVisibilityConverter}}"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="أعضاء المجموعة" Style="{StaticResource TitleText}" FontSize="18" /><TextBlock Text="مكالمة جماعية من نافذة الغرف" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" /></Grid><ListBox ItemsSource="{Binding SelectedConversation.Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,3"><TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" /></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel DockPanel.Dock="Bottom"><StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="إضافة عضو" Style="{StaticResource FieldLabel}" Margin="2,10,2,6" /><ComboBox Style="{StaticResource RoundedComboBox}" Height="38" ItemsSource="{Binding OnlineUsers}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Text="{Binding NewMemberUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="اكتب بداية الاسم ثم اختره" /><Button Content="إضافة العضو المختار" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" Command="{Binding AddMemberCommand}" /><Button Content="إزالة العضو المحدد" Style="{StaticResource DangerButton}" Margin="0,6,0,0" Command="{Binding RemoveMemberCommand}" /></StackPanel><Button Content="مغادرة المجموعة" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Command="{Binding LeaveGroupCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBooleanToVisibilityConverter}}" /></StackPanel></DockPanel></Border>
        </Grid>
    </Grid>
</Window>
