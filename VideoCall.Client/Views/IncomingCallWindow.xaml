<Window x:Class="VideoCall.Client.Views.IncomingCallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مكالمة واردة" Width="390" Height="285" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><Border Style="{StaticResource CardStyle}" Padding="28"><StackPanel><Border Background="#182A47" CornerRadius="50" Width="64" Height="64" HorizontalAlignment="Center"><TextBlock Text="☎" Foreground="{StaticResource BrushPrimary}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="CallerText" Style="{StaticResource TitleText}" TextAlignment="Center" Margin="0,16,0,0" /><TextBlock Text="يحاول الاتصال بك الآن" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0"><Button Content="قبول" Style="{StaticResource SuccessButton}" Width="115" Click="Accept_Click" /><Button Content="رفض" Style="{StaticResource DangerButton}" Width="115" Margin="10,0,0,0" Click="Reject_Click" /></StackPanel></StackPanel></Border></Window>
