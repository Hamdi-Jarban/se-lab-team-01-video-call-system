<Window x:Class="VideoCall.Client.Views.GroupCallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="المحادثة الجماعية" Height="780" Width="1200" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18"><StackPanel><TextBlock Text="المكالمة الجماعية الصوتية والمرئية" Style="{StaticResource TitleText}" /><TextBlock Text="{Binding RoomId, StringFormat='الغرفة: {0}'}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" /></StackPanel><Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" /></Border></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="265" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="المعاينة المحلية" Style="{StaticResource FieldLabel}" /><Border Background="#0A101B" CornerRadius="16" Height="195" Margin="0,0,0,16"><Grid><Image Source="{Binding LocalVideo}" Stretch="Uniform" Margin="6" /><TextBlock Text="الكاميرا متوقفة" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Border><Border Style="{StaticResource CardStyle}" Padding="16"><StackPanel><TextBlock Text="المشاركون" Style="{StaticResource FieldLabel}" /><ItemsControl ItemsSource="{Binding Participants}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><Ellipse Width="9" Height="9" Fill="{StaticResource BrushSuccess}" Margin="0,0,9,0" /><TextBlock Text="{Binding Username}" Foreground="{StaticResource BrushTextPrimary}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel><Border Grid.Column="2" Background="#0A101B" CornerRadius="18" Padding="8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Participants}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurface}" CornerRadius="14" Margin="7" MinHeight="235"><Grid><Image Source="{Binding Video}" Stretch="Uniform" Margin="6" /><TextBlock Text="لا توجد صورة" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Video, Converter={StaticResource NullToVisibilityConverter}}" /><Border Background="#D9080D18" VerticalAlignment="Bottom" Padding="11,8"><DockPanel><TextBlock Text="{Binding Username}" Foreground="White" FontWeight="SemiBold" /><TextBlock DockPanel.Dock="Right" Text="{Binding IsMuted, StringFormat='كتم: {0}'}" Foreground="#C5D1E5" FontSize="11" /></DockPanel></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></Grid>
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" CornerRadius="14" Padding="13" Margin="0,18,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="الميكروفون" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleMuteCommand}" /><Button Content="تشغيل / إيقاف الفيديو" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ToggleCameraCommand}" /><Button Content="مغادرة المكالمة" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding LeaveCommand}" /></StackPanel></Border>
    </Grid>
</Window>
