<Window x:Class="VideoCall.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — VideoCallSystem" Height="650" Width="980" MinHeight="580" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Grid Margin="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BrushPrimaryDark}" CornerRadius="18" Padding="38" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#25D366" CornerRadius="22" Width="72" Height="72" HorizontalAlignment="Right" Margin="0,0,0,24"><TextBlock Text="VC" FontSize="27" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="أهلًا بك في" Foreground="#BFE8DF" FontSize="16" TextAlignment="Right" />
                    <TextBlock Text="VideoCallSystem" FontSize="30" FontWeight="Bold" Foreground="White" TextAlignment="Right" Margin="0,5,0,0" />
                    <TextBlock Text="تواصل ببساطة. كن قريبًا دائمًا." FontSize="19" Foreground="#D7F5EE" TextAlignment="Right" Margin="0,14,0,0" />
                    <TextBlock Text="محادثات خاصة، مجموعات، ومكالمات صوتية ومرئية في تجربة مألوفة وسريعة." Foreground="#BFE8DF" TextWrapping="Wrap" TextAlignment="Right" LineHeight="24" Margin="0,22,0,0" />
                    <StackPanel Margin="0,26,0,0">
                        <DockPanel Margin="0,8"><Ellipse Width="8" Height="8" Fill="#25D366" Margin="0,0,10,0" /><TextBlock Text="مكالمات جماعية بضغطة واحدة" Foreground="White" /></DockPanel>
                        <DockPanel Margin="0,8"><Ellipse Width="8" Height="8" Fill="#25D366" Margin="0,0,10,0" /><TextBlock Text="رسائل مرتبة وسهلة القراءة" Foreground="White" /></DockPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="خصوصيتك أولًا — اتصال مباشر عبر الخادم" Foreground="#BFE8DF" TextAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="40" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="تسجيل الدخول" Style="{StaticResource TitleText}" /><TextBlock Text="أدخل بياناتك للعودة إلى محادثاتك" Style="{StaticResource SubtitleText}" Margin="0,7,0,28" /></StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}" Height="54" Margin="0,0,0,17" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" />
                    <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" Height="54" Margin="0,0,0,17" />
                    <TextBlock Text="عنوان الخادم" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ServerBox" Style="{StaticResource RoundedTextBox}" Height="54" Margin="0,0,0,25" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" />
                    <Button x:Name="LoginButton" Content="دخول إلى حسابي" Style="{StaticResource PrimaryButton}" Height="52" Click="LoginButton_Click" />
                    <Button x:Name="RegisterButton" Content="إنشاء حساب جديد" Style="{StaticResource SecondaryButton}" Height="46" Margin="0,10,0,0" Click="Register_Click" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,0" />
                    <TextBlock Text="للاختبار المحلي استخدم 127.0.0.1 كعنوان الخادم" Foreground="{StaticResource BrushTextMuted}" TextAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
