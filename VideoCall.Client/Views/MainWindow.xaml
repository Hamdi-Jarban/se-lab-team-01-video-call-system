<Window x:Class="VideoCall.Client.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VideoCallSystem" Width="660" Height="700" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions><RowDefinition Height="92" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrushPrimaryDark}" Padding="28,18"><Grid><StackPanel><TextBlock Text="VideoCallSystem" Foreground="White" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="مركز اتصالاتك" Foreground="#BFE8DF" FontSize="12" Margin="0,3,0,0" /></StackPanel><Border Style="{StaticResource StatusPill}" Background="#E3FFF1" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectionStatus}" Foreground="#087F5B" /></Border></Grid></Border>
        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="26,13"><TextBlock Text="{Binding CurrentUsername, StringFormat='مرحبًا، {0}'}" Foreground="{StaticResource BrushTextSecondary}" /></Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="24,22,24,0" Padding="18"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,14"><StackPanel><TextBlock Text="متصلون الآن" Style="{StaticResource TitleText}" FontSize="19" /><TextBlock Text="ابدأ محادثة أو مكالمة مباشرة" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left"><TextBlock Text="● مباشر" Foreground="{StaticResource BrushSuccess}" /></Border></Grid><ListBox ItemsSource="{Binding OnlineUsers}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="{StaticResource BrushSurfaceElevated}" CornerRadius="22" Width="38" Height="38"><TextBlock Text="•" Foreground="{StaticResource BrushPrimaryDark}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" /><TextBlock Text="متاح للمحادثة" Foreground="{StaticResource BrushTextMuted}" FontSize="11" /></StackPanel></StackPanel><Button Grid.Column="1" Content="مراسلة" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,6,0" Tag="{Binding}" Click="Message_Click" /><Button Grid.Column="2" Content="اتصال" Style="{StaticResource PrimaryButton}" Padding="14,7" Tag="{Binding}" Click="Call_Click" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
        <Grid Grid.Row="3" Margin="24,18,24,24"><TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,58" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="المحادثات" Style="{StaticResource PrimaryButton}" Click="Chats_Click" /><Button Content="الغرف الجماعية" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Rooms_Click" /><Button Content="خروج" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Logout_Click" /></StackPanel></Grid>
    </Grid>
</Window>
