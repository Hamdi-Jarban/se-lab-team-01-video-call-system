<Window x:Class="VideoCall.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCallSystem" Width="560" Height="620"
        WindowStartupLocation="CenterScreen">
    <!-- Issue #3:
     يعتمد هذا الجزء على OnlineUsers التي يوفرها كود قائمة المستخدمين. -->
    <ListBox ItemsSource="{Binding OnlineUsers}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                    Text="{Binding}"
                    VerticalAlignment="Center" />

                    <!-- Issue #3:
                     زر إرسال طلب مكالمة للمستخدم المحدد. -->
                    <Button
                    Grid.Column="1"
                    Content="اتصال خاص"
                    Tag="{Binding}"
                    Click="Call_Click"
                    IsEnabled="{Binding
                        DataContext.IsCallRequestPending,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource InverseBooleanConverter}}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <!-- Issue #3:
     يعتمد على Status الموجود في MainViewModel لعرض حالة الانتظار أو الخطأ. -->
    <TextBlock
    Text="{Binding Status}"
    TextWrapping="Wrap" />

</Window>
