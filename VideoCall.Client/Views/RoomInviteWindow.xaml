<Window x:Class="VideoCall.Client.Views.RoomInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دعوة إلى غرفة جماعية" Width="360" Height="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <!-- نافذة منبثقة (Popup) ثابتة الحجم تظهر في منتصف النافذة المالكة لها عند تلقي دعوة -->
    <Border Background="#0F172A" Padding="24">
        <StackPanel>
            <!-- نص الدعوة: تم إعطاؤه اسماً (x:Name) ليتم تمرير اسم المرسل أو رقم الغرفة إليه مباشرة من الكود الخلفي -->
            <TextBlock x:Name="InviteText" Foreground="#F8FAFC" FontSize="18"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
            
            <!-- أزرار الاستجابة: مرتبطة بأحداث مباشرة (Click) في الكود الخلفي لإرجاع النتيجة (قبول/رفض) وإغلاق النافذة بسرعة -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="قبول" Width="110" Margin="6" Style="{StaticResource SuccessButton}" Click="Accept_Click" />
                <Button Content="رفض" Width="110" Margin="6" Style="{StaticResource DangerButton}" Click="Reject_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>