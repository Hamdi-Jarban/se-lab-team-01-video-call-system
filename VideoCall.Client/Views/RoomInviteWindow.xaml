<Window x:Class="VideoCall.Client.Views.RoomInviteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="دعوة إلى غرفة جماعية" Width="420" Height="280" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><Border Style="{StaticResource CardStyle}" Padding="28"><StackPanel><Border Background="#182A47" CornerRadius="50" Width="64" Height="64" HorizontalAlignment="Center"><TextBlock Text="↗" Foreground="{StaticResource BrushPrimary}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="InviteText" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,17,0,23" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="قبول" Width="120" Style="{StaticResource SuccessButton}" Margin="6" Click="Accept_Click" /><Button Content="رفض" Width="120" Style="{StaticResource DangerButton}" Margin="6" Click="Reject_Click" /></StackPanel></StackPanel></Border></Window>
